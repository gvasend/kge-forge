ENANCE_SUPPORT'\n   return 'STRUCTURALLY_COMPLETE_NOT_AUTHENTICATED'\n  if kind=='EXPECTED_ABSENCE':\n   if not v['gate'] or not v['request'] or not v['proposition'] or not v['receipt'] or not v['reentry']:return 'MISSING_ABSENCE_BINDING'\n   if v['evidence_received'] is not False or v['positive_evidence']!=[]:return 'FABRICATED_EVIDENCE'\n   if v['state']!='WAITING_FOR_EXTERNAL_EVIDENCE':return 'INVALID_WAIT'\n   return 'ACCEPT_SYNTHETIC_ABSENCE_ENVELOPE'\n  if kind=='MIGRATION_MANIFEST':\n   if set(v)!=set(contract['MigrationManifest']['required_fields']):return 'MANIFEST_FIELDS'\n   if v['SOURCE_FORMAT']!='E1_LEGACY_V1' or v['TARGET_FORMAT']!='PLANNER_SNAPSHOT_V0_1' or v['native_schema']!='PLANNER-SNAPSHOT-1':return 'FORMAT'\n   if v['qualification'] not in ['NOT_QUALIFIED','QUALIFIED_MIGRATION']:return 'QUALIFICATION_ENUM'\n   if v['qualification']=='QUALIFIED_MIGRATION' and (v['unresolved_prerequisites'] or not v['qualification_record'] or not v['snapshot'] or not v['bundle']):return 'UNJUSTIFIED_QUALIFICATION'\n   return 'VALID_DIAGNOSTIC_MANIFEST_NOT_QUALIFICATION'\n  return 'UNKNOWN_ORACLE'\n except (KeyError,TypeError,ValueError):return 'MALFORMED_INPUT'\n",
