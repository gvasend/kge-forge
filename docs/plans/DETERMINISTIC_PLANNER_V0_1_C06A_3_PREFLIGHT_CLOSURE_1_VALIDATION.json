  "specification_runner": "import json,sys,copy,hashlib\nfrom pathlib import Path\np=Path('docs/plans');stem='DETERMINISTIC_PLANNER_V0_1_C06A_3_PREFLIGHT_CLOSURE_1'\nc=json.loads((p/(stem+'.json')).read_text());f=json.loads((p/(stem+'_FIXTURES.json')).read_text());n={};exec(c['reference']['program'],n)\nprograms={k:json.loads((p/v).read_text())['reference']['program'] for k,v in c['oracle_program_paths'].items()}\ndef rev(x):\n if type(x) is dict:return {k:rev(v) for k,v in reversed(list(x.items()))}\n if type(x) is list:return [rev(v) for v in x]\n return x\ndef run(profile,base,family):return n['compose'](profile,base['state'],base['validity'],programs,c['existing_admission_submissions']) if family=='INSTANCE' else n['evaluate'](profile,base['state'],base['validity'],family)\ndef subset(a,b):\n if isinstance(a,dict):return all(k in b and subset(v,b[k]) for k,v in a.items())\n return a==b\nrows=[]\nfor case in reversed(f['cases']):\n x=copy.deepcopy(f['bases'][case['base']]);pr=c['profiles'][case['base']]\n for m in case['mutations']:\n  ps=m['path'].split('/')[1:];o=x\n  for k in ps[:-1]:o=o[int(k)] if type(o) is list else o[k]\n  k=int(ps[-1]) if type(o) is list else ps[-1]\n  if m['op']=='remove':del o[k]\n  else:o[k]=m['value']\n out=run(pr,x,case['family']);assert out['accepted']==case['expected_accepted'] and out['failed_clause']==case['expected_clause']\n if 'expected_projection' in case:assert subset(case['expected_projection'],out['output'])\n if 'expected_eligible' in case:assert out['output']['prerequisite_eligible']==case['expected_eligible'] and all(not k['current'] for k in out['output']['knowledge'].values())\n assert run(rev(pr),rev(x),case['family'])==out\n assert run(json.loads(n['canon'](pr)),json.loads(n['canon'](x)),case['family'])==out\n rows.append([case['id'],out])\n# Both components admissible independently; mixing them must reject.\na=f['bases']['BASE'];b=f['bases']['RENAMED'];assert run(c['profiles']['BASE'],a,'GRAPH')['accepted'];assert run(c['profiles']['RENAMED'],b,'GRAPH')['accepted']\nx=copy.deepcopy(a);x['state']['sources']['graph']=copy.deepcopy(b['state']['sources']['graph']);out=run(c['profiles']['BASE'],x,'INSTANCE');assert out['failed_clause']=='SOURCE_PIN';rows.append(['MIX_INDIVIDUALLY_ADMITTED_GRAPHS',out])\n# Invalidate support after a successful import-equivalent admission, retaining bytes.\nfor label,base in f['bases'].items():\n for role in base['validity']['sources']:\n  assert run(c['profiles'][label],base,'INSTANCE')['accepted'];x=json.loads(n['canon'](base));x['validity']['sources'][role]['state']='STALE';x=json.loads(n['canon'](x));out=run(c['profiles'][label],x,'INSTANCE');assert not out['accepted'];rows.append([label+'-INVALIDATE-'+role,out])\nprint(n['digest'](sorted(rows)))\nif len(sys.argv)>1:Path(sys.argv[1]).write_text(json.dumps({'additional_sequences':11,'canonical_output_digest':n['digest'](sorted(rows)),'all_62_cases_roundtrip_and_key_reversal':'PASS','mixed_individually_accepted_graphs':'REJECT_SOURCE_PIN','invalidation_sequences':10},indent=2)+'\\n')\n",
