                ],
                "title": "ExternalSandboxSandboxPolicyType",
                "type": "string"
              }
            },
            "required": [
              "type"
            ],
            "title": "ExternalSandboxSandboxPolicy",
            "type": "object"
          },
          {
            "properties": {
              "excludeSlashTmp": {
                "default": false,
                "type": "boolean"
              },
              "excludeTmpdirEnvVar": {
